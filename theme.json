{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"palette": [
				{
					"color": "#ffffff",
					"name": "White",
					"slug": "white"
				},
				{
					"color": "#f4f4f4",
					"name": "Gray 10",
					"slug": "gray-10"
				},
				{
					"color": "#393939",
					"name": "Gray 90",
					"slug": "gray-90"
				},
				{
					"color": "#161616",
					"name": "Gray 100",
					"slug": "gray-100"
				},
				{
					"color": "#0f62fe",
					"name": "Blue 60",
					"slug": "blue-60"
				},
				{
					"color": "#0043ce",
					"name": "Blue 70",
					"slug": "blue-70"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "\"IBM Plex Sans\", sans-serif",
					"name": "IBM Plex Sans",
					"slug": "ibm-plex-sans"
				}
			],
			"fontSizes": [
				{
					"size": "0.75rem",
					"name": "Extra Small",
					"slug": "xs"
				},
				{
					"size": "0.875rem",
					"name": "Small",
					"slug": "sm"
				},
				{
					"size": "1rem",
					"name": "Medium",
					"slug": "md"
				},
				{
					"size": "1.25rem",
					"name": "Large",
					"slug": "lg"
				},
				{
					"size": "1.5rem",
					"name": "Extra Large",
					"slug": "xl"
				},
				{
					"size": "2rem",
					"name": "2XL",
					"slug": "2xl"
				},
				{
					"size": "3rem",
					"name": "3XL",
					"slug": "3xl"
				},
				{
					"size": "4rem",
					"name": "4XL",
					"slug": "4xl"
				}
			]
		},
		"layout": {
			"contentSize": "800px",
			"wideSize": "1200px"
		},
		"spacing": {
			"spacingScale": {
				"steps": 0
			},
			"spacingSizes": [
				{
					"size": "0.25rem",
					"name": "1",
					"slug": "1"
				},
				{
					"size": "0.5rem",
					"name": "2",
					"slug": "2"
				},
				{
					"size": "0.75rem",
					"name": "3",
					"slug": "3"
				},
				{
					"size": "1rem",
					"name": "4",
					"slug": "4"
				},
				{
					"size": "1.5rem",
					"name": "6",
					"slug": "6"
				},
				{
					"size": "2rem",
					"name": "8",
					"slug": "8"
				},
				{
					"size": "3rem",
					"name": "12",
					"slug": "12"
				},
				{
					"size": "4rem",
					"name": "16",
					"slug": "16"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--gray-100)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--ibm-plex-sans)",
			"lineHeight": "1.5"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--blue-60)"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--blue-70)"
					},
					"typography": {
						"textDecoration": "underline"
					}
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "300",
					"lineHeight": "1.2"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--blue-60)",
					"text": "var(--wp--preset--color--white)"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "1rem",
						"right": "1rem"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--sm)",
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--blue-70)"
					}
				}
			}
		}
	}
}
